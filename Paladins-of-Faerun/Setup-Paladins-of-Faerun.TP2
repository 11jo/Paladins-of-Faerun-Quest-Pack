/*************************************************************************
 * Paladins of Faerun Quest Pack  - v4.0
 **************************************************************************/
 
 
BACKUP ~weidu_external/Paladins-of-Faerun/backup~
SUPPORT ~https://github.com/11jo/Paladins-of-Faerun-Quest-Pack/issues~


README ~Paladins-of-Faerun/Readme/Readme_Paladins-of-Faerun_english.txt~	~Paladins-of-Faerun/Readme/Readme_Paladins-of-Faerun_%LANGUAGE%.txt~

VERSION ~4.0~

ALWAYS

	ACTION_IF GAME_IS ~bgt~ BEGIN
		INCLUDE ~Paladins-of-Faerun/Lib/g3_bgt_cpmvars.tpa~
		PRINT ~Game is BGT~
	END ELSE ACTION_IF GAME_IS ~eet~ BEGIN
		INCLUDE ~eet/other/cpmvars/eet_cpmvars.tpa~
		PRINT ~Game is EET~
	END

		INCLUDE ~Paladins-of-Faerun/lib/gw_functions.tpa~

// EET chapter check, used for Add variables to PoF AREAS and prevent specific events from triggering during PoF travels...

	ACTION_IF GAME_IS ~eet~ BEGIN
			OUTER_SET bg2_chapter = 12
	END ELSE BEGIN
			OUTER_SET bg2_chapter = 0
	END
			OUTER_FOR (i = 1 ; i <= 10 ; ++i) BEGIN
			OUTER_SET bg2_chapter = bg2_chapter + 1
			OUTER_SPRINT name_source ~bg2_chapter_%i%~
			OUTER_SET EVAL ~%name_source%~ = bg2_chapter
	END

// Use original BG/EET areas

	ACTION_IF NOT GAME_IS ~bgt eet~ BEGIN
			OUTER_SPRINT "MINSC_JOINED"								"MINSCJ"
			OUTER_SPRINT "NBaldursGate_BCS"							"XG0020"
			OUTER_SPRINT "NBaldursGate_DucalPalace_Cellar_BCS"		"XG0620"
			OUTER_SPRINT "NBaldursGate_RinniesHouse_L1_BCS"			"XG0520"
			OUTER_SPRINT "NBaldursGate_RamazithsTower_L1_BCS"		"XG0320"
			OUTER_SPRINT "NBaldursGate_ThreeOldKegs_L1_BCS"			"XG0120"
			OUTER_SPRINT "NBaldursGate_ThreeOldKegs_L3_BCS"			"XG0820"
			OUTER_SPRINT "NBaldursGate"								"XG0020"
			OUTER_SPRINT "NBaldursGate_DucalPalace_Cellar"			"XG0620"
			OUTER_SPRINT "NBaldursGate_RinniesHouse_L1"				"XG0520"
			OUTER_SPRINT "NBaldursGate_RamazithsTower_L1"			"XG0320"
			OUTER_SPRINT "NBaldursGate_ThreeOldKegs_L1"				"XG0120"
			OUTER_SPRINT "NBaldursGate_ThreeOldKegs_L3"				"XG0820"
		PRINT ~Game is BG2 or BG2EE~
	END

	//Copies tra files into the autotra-folder (to leave the originals untouched)
	DEFINE_ACTION_FUNCTION autotra_workaround BEGIN
	COPY ~Paladins-of-Faerun/Languages/english/Baf_new~				~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/Baf_new~
	COPY ~Paladins-of-Faerun/Languages/english/Baf_are~				~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/Baf_are~
	COPY ~Paladins-of-Faerun/Languages/english/D~						~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/D~
	COPY ~Paladins-of-Faerun/Languages/english~						~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%~
	COPY ~Paladins-of-Faerun/Languages/%LANGUAGE%/Baf_new~			~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/Baf_new~
	COPY ~Paladins-of-Faerun/Languages/%LANGUAGE%/Baf_are~			~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/Baf_are~
	COPY ~Paladins-of-Faerun/Languages/%LANGUAGE%/D~					~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/D~
	COPY ~Paladins-of-Faerun/Languages/%LANGUAGE%~					~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%~
	END

	LAF autotra_workaround END

	ACTION_IF GAME_IS ~bg2ee eet~ BEGIN
//  ACTION_DEFINE_ARRAY PoF_noconvert BEGIN END

		ACTION_DEFINE_ARRAY PoF_reload BEGIN Setup-Paladins-of-Faerun Journal XGBOOKP END

			LAF HANDLE_CHARSETS
				INT_VAR
				infer_charsets = 1
				STR_VAR
				tra_path = EVAL ~weidu_external/Paladins-of-Faerun/Languages/autotra~
				out_path = EVAL ~weidu_external/Paladins-of-Faerun/Languages/autotra/UTF8~
				iconv_path = ~Paladins-of-Faerun/Languages/autotra/iconv~
				// noconvert_array = PoF_noconvert
				reload_array = PoF_reload
			END

	// Backup ANSI
	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%~			~weidu_external/Paladins-of-Faerun/Languages/autotra/ANSI/%LANGUAGE%~
	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/Baf_new~			~weidu_external/Paladins-of-Faerun/Languages/autotra/ANSI/%LANGUAGE%/Baf_new~
	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/Baf_are~			~weidu_external/Paladins-of-Faerun/Languages/autotra/ANSI/%LANGUAGE%/Baf_are~
	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/D~			~weidu_external/Paladins-of-Faerun/Languages/autotra/ANSI/%LANGUAGE%/D~
	// UTF8 only
	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/UTF8/%LANGUAGE%~			~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%~
	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/UTF8/%LANGUAGE%/Baf_new~			~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/Baf_new~
	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/UTF8/%LANGUAGE%/Baf_are~			~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/Baf_are~
	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/UTF8/%LANGUAGE%/D~			~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/D~
	END

END

AUTO_TRA ~weidu_external/Paladins-of-Faerun/Languages/autotra/%s/D~
AUTO_TRA ~weidu_external/Paladins-of-Faerun/Languages/autotra/%s/Baf_new~
AUTO_TRA ~weidu_external/Paladins-of-Faerun/Languages/autotra/%s/Baf_are~

LANGUAGE	~Russian~
			~russian~
			~Paladins-of-Faerun/Languages/Russian/SETUP-Paladins-of-Faerun.tra~
			~Paladins-of-Faerun/Languages/Russian/Journal.tra~
			~Paladins-of-Faerun/Languages/Russian/XGBOOKP.tra~
			//~Paladins-of-Faerun/Languages/Russian/Journal.tra~

LANGUAGE	~English~
			~english~
			~Paladins-of-Faerun/Languages/English/SETUP-Paladins-of-Faerun.tra~
			~Paladins-of-Faerun/Languages/English/Journal.tra~
			~Paladins-of-Faerun/Languages/English/XGBOOKP.tra~
			//~Paladins-of-Faerun/Languages/English/Journal.tra~

LANGUAGE	~German~
			~German~
			~Paladins-of-Faerun/Languages/German/SETUP-Paladins-of-Faerun.tra~
			~Paladins-of-Faerun/Languages/German/Journal.tra~
			~Paladins-of-Faerun/Languages/German/XGBOOKP.tra~
			//~Paladins-of-Faerun/Languages/German/Journal.tra~

LANGUAGE	~Main English / Francais Partiel~
			~French~
			~Paladins-of-Faerun/Languages/French/SETUP-Paladins-of-Faerun.tra~
			~Paladins-of-Faerun/Languages/French/Journal.tra~
			~Paladins-of-Faerun/Languages/French/XGBOOKP.tra~
			//~Paladins-of-Faerun/Languages/French/Journal.tra~


///////////////////////////////////
// Start Paladins of Faerun Quest Pack
//////////////////////////////////

BEGIN @1
DESIGNATED 1
LABEL ~BGslayer-PoF~


//////////////////////////////////
// Other
//////////////////////////////////

	INCLUDE ~Paladins-of-Faerun/Lib/PoF_Macros/arrays-macros.tpa~ // Unused
		INCLUDE ~Paladins-of-Faerun/Lib/PoF_Macros/Area-macros.tpa~
			INCLUDE ~Paladins-of-Faerun/Lib/PoF_Macros/Bam-macros.tpa~
				INCLUDE ~Paladins-of-Faerun/Lib/PoF_Macros/Creature-macros.tpa~
					INCLUDE ~Paladins-of-Faerun/Lib/PoF_Macros/Item-macros.tpa~

COPY ~Paladins-of-Faerun/bam~			~override~

COPY ~Paladins-of-Faerun/wav~			~override~

COPY ~Paladins-of-Faerun/maps~			~override~


// Portrait

ACTION_IF (GAME_IS ~bg2ee eet~) BEGIN

	COPY ~Paladins-of-Faerun/Portraits/EE~			~override~

END

ACTION_IF (GAME_IS ~tob bgt~) BEGIN

	COPY ~Paladins-of-Faerun/Portraits/Vanilla~			~override~

END


// BG1 audio missing in BG2

/*
ACTION_IF (GAME_IS ~tob bg2ee~) BEGIN

	COPY ~Paladins-of-Faerun/OTHER/Missing_Audio~			~override~

END
*/

	ACTION_IF (NOT FILE_EXISTS_IN_GAME ~#EFF_P32.WAV~) BEGIN
			COPY ~Paladins-of-Faerun/OTHER/Missing_Audio/#EFF_P32.WAV~			~override~
	END

	ACTION_IF (NOT FILE_EXISTS_IN_GAME ~AMB_E14A.WAV~) BEGIN
			COPY ~Paladins-of-Faerun/OTHER/Missing_Audio/AMB_E14A.WAV~			~override~
	END

	ACTION_IF (NOT FILE_EXISTS_IN_GAME ~AMB_S01.WAV~) BEGIN
			COPY ~Paladins-of-Faerun/OTHER/Missing_Audio/AMB_S01.WAV~			~override~
	END

	ACTION_IF (NOT FILE_EXISTS_IN_GAME ~AMB_S01A.WAV~) BEGIN
			COPY ~Paladins-of-Faerun/OTHER/Missing_Audio/AMB_S01A.WAV~			~override~
	END

	ACTION_IF (NOT FILE_EXISTS_IN_GAME ~AMB_S21.WAV~) BEGIN
			COPY ~Paladins-of-Faerun/OTHER/Missing_Audio/AMB_S21.WAV~			~override~
	END


/*
// COPY ~Paladins-of-Faerun/OTHER/SPPR112.SPL~         ~override/SPPR112.SPL~ UNLESS ~SPPR112.SPL~
// To remove after XG1053.baf modification
// APPEND ~SPELL.IDS~ ~1112 CLERIC_CIRCLE_OF_PROTECTION~ UNLESS ~1112 CLERIC_CIRCLE_OF_PROTECTION~

Nonsense between CLERIC_CIRCLE_OF_PROTECTION and Imprécation, TO DELETE OR ELSE...
ACTION_IF (NOT FILE_EXISTS_IN_GAME ~SPPR112.SPL~) BEGIN // IWD spell for CLERIC_CURSE
ADD_SPELL ~Paladins-of-Faerun/OTHER/IWD.Spell/SPPR112.SPL~ 2 1 ~CLERIC_CURSE~
		SAY NAME1 @1067
		SAY NAME2 @1067
		SAY DESC @1068
		SAY UNIDENTIFIED_DESC @1068
END
*/

ACTION_IF (GAME_IS ~tob bgt~) BEGIN
  
  APPEND ~state.ids~ ~0x80101FEF CD_STATE_NOTVALID~ UNLESS ~^0x80101FEF[ %TAB]+CD_STATE_NOTVALID[ %TAB%%LNL%%MNL%%WNL%]~
  
  APPEND ~action.ids~ ~353 AdvanceTime(I:Time*GTIMES)~ UNLESS ~353 AdvanceTime(I:Time*GTIMES)~
  
  APPEND ~SPELL.IDS~ ~2509	WIZARD_FEEBLEMIND~ UNLESS ~2509	WIZARD_FEEBLEMIND~
  
  APPEND ~SPELL.IDS~ ~2221	WIZARD_RAY_OF_ENFEEBLEMENT~ UNLESS ~2221	WIZARD_RAY_OF_ENFEEBLEMENT~
  
  APPEND ~OBJECT.IDS~ ~95 NearestAllyOf~ UNLESS ~95	NearestAllyOf~
  
  APPEND ~GTimes.IDS~ ~61	ONE_TURN~ UNLESS ~61	ONE_TURN~
  
  APPEND ~GTimes.IDS~ ~240	FOUR_TURNS~ UNLESS ~240	FOUR_TURNS~

END


// Trap script for XG0152.are

COMPILE ~Paladins-of-Faerun/OTHER/BCS.TrapforXG0152~


// Item ressources for XGCMA03.ITM, XGHELM4 and IWD bam

COPY ~Paladins-of-Faerun/OTHER/SPELL.ForItem/XGSPMOD1.SPL~			~override/XGSPMOD1.SPL~
	SAY NAME1 @1200
	SAY UNIDENTIFIED_DESC @1201
	SAY DESC @1201

COPY ~Paladins-of-Faerun/OTHER/SPELL.ForItem/XGSPMOD2.SPL~			~override/XGSPMOD2.SPL~
	SAY NAME1 @1202
	SAY UNIDENTIFIED_DESC @1203
	SAY DESC @1203

	ACTION_IF (NOT FILE_EXISTS_IN_GAME ~SPWI525B.BAM~) BEGIN
			COPY ~Paladins-of-Faerun/OTHER/SPELL.ForItem/SPWI525B.BAM~			~override~
	END

	ACTION_IF (NOT FILE_EXISTS_IN_GAME ~SPWI525C.BAM~) BEGIN
			COPY ~Paladins-of-Faerun/OTHER/SPELL.ForItem/SPWI525C.BAM~			~override~
	END


// Add FARAWAY to AREATYPE.IDS (Borrowed from EET by K4thos )

	// ADD_AREA_TYPE FARAWAY
	// OUTER_SET dummy = IDS_OF_SYMBOL (AREATYPE FARAWAY)
	// PRINT ~FARAWAY = %FARAWAY% (%dummy%)~


// Add variables to PoF AREAS (Thanks to Argent77 )

MKDIR ~weidu_external/Paladins-of-Faerun/Areas~

ACTION_BASH_FOR ~Paladins-of-Faerun/Areas~ ~^.+$~ BEGIN

	PRINT ~         ~
	PRINT ~Start AREATYPE (with variable)~
	PRINT ~         ~

	COPY ~%BASH_FOR_FILESPEC%~ ~weidu_external/%BASH_FOR_FILESPEC%~
		LPF fj_are_structure
			INT_VAR
			fj_variable_value = 1
			STR_VAR
			fj_structure_type = "variable"
			fj_name           = "POFAREA"
		END


	// COPY ~%BASH_FOR_FILESPEC%~ ~weidu_external/%BASH_FOR_FILESPEC%~
		// WRITE_SHORT 0x48 THIS | (1 << FARAWAY)
		
		// WRITE_LONG 0x"XX" (THIS BAND BNOT BIT"xx")	// remove Flag


/*	
	// Area script assigner
	READ_ASCII 0x94 "script"
	PATCH_IF (FILE_EXISTS ~Paladins-of-Faerun/baf_new/%script%.baf~) BEGIN
	END ELSE PATCH_IF (FILE_EXISTS ~Paladins-of-Faerun/baf_new/%SOURCE_RES%.baf~) BEGIN
		PATCH_PRINT ~%SOURCE_FILE% - Area script (%SOURCE_RES%.BCS) assigned~
		WRITE_ASCIIE 0x94 ~%SOURCE_RES%~ #8
	END ELSE PATCH_IF (~%script%~ STR_CMP ~~) AND (NOT ~%script%~ STR_EQ ~NONE~) BEGIN
		PATCH_PRINT ~%SOURCE_FILE% - Missing area script (%script%.BCS) created~
