		tisunpack_path = ~Paladins-of-Faerun/tools~
	END

END

/*

En attente de voir s'il est possible de convertir pour vanilla et avoir un seul set de fichier Tis

  // *** Installation of TIS and MOS files (Light Version) ***

INCLUDE ~%MOD_FOLDER%/lib/a7_tools.tpa~
  // installing TIS for vanila
  ACTION_BASH_FOR  ~%MOD_FOLDER%/TIS.EE~ ~.*\.TIS$~ BEGIN
    LAF HANDLE_TILE2EE
      INT_VAR
        silent = 0  // show feedback
      STR_VAR
        input_path = EVAL ~%BASH_FOR_FILESPEC%~
      RET
        num_converted
    END
    ACTION_IF (num_converted != 1) BEGIN
      FAIL ~Error converting %file%~
    END
  END
*/


