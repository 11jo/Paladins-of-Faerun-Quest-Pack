// Invisible creatures for some Cutscene and else

COPY ~Paladins-of-Faerun/OTHER/JoNEANT/Cre/JONEAN10.CRE~			~override/XGNEAN10.CRE~
	WRITE_ASCII 0x280 ~XGNEAN10~ (8) // Script name / Death variable

COPY ~Paladins-of-Faerun/OTHER/JoNEANT/Cre/JONEANT4.CRE~			~override/XGNEANT4.CRE~
	WRITE_ASCII 0x280 ~XGNEANT4~ (8) // Script name / Death variable

COPY ~Paladins-of-Faerun/OTHER/JoNEANT/Cre/JONEANT.CRE~			~override/XGNEANT.CRE~
	WRITE_ASCII 0x280 ~XGNEANT~ (8) // Script name / Death variable

COPY ~Paladins-of-Faerun/OTHER/JoNEANT/Cre/JONEAN28.CRE~			~override/XGNEAN28.CRE~
	WRITE_ASCII 0x280 ~XGNEAN28~ (8) // Script name / Death variable


// Script name / Death variable for AMNG1 / AMNG2.CRE (xgpir.baf)

COPY_EXISTING ~AMNG1.CRE~			~override/XGAMNG1.CRE~
	WRITE_ASCII 0x280 ~XGAMNG1~ (8) // Script name / Death variable
	WRITE_ASCII 0x2CC ~AMNG2~ (8) // Dialog name

COPY_EXISTING ~AMNG2.CRE~			~override/XGAMNG2.CRE~
	WRITE_ASCII 0x280 ~XGAMNG2~ (8) // Script name / Death variable


// Blacksmith Marian

COPY_EXISTING ~PRISONG1.CRE~			~override/XGPRISO1.CRE~
	WRITE_ASCII 0x280 ~XGPRISO1~ (8) // Script name / Death variable

COPY_EXISTING ~PRISONK1.CRE~			~override/XGPRISON.CRE~
	WRITE_ASCII 0x280 ~XGPRISON~ (8) // Script name / Death variable
	WRITE_ASCII 0x2CC ~XGPRISON~ (8) // Dialog name


// A farmer in Trademeet

COPY_EXISTING ~JAGUARSU.CRE~			~override/XGJAGU.CRE~
	WRITE_BYTE 0x270 ~255~


// Missing script name / Death variable for existing ELAIR01.CRE (XG0762)

COPY_EXISTING ~ELAIR01.CRE~				~override/XGELAIR.cre~
	WRITE_ASCII 0x280 ~XGELAIR~ (8)


// Modify GORGOLI.cre to XGGOICE

COPY_EXISTING ~GOLICE01.cre~			~override/XGGOICE.cre~
	WRITE_LONG 0x14 ~2500~ // XP value
	// WRITE_ASCII 0x248 ~XGGOICE~ (8) // Override Script variable // Unused since modified on the area.


// Modify tanadv03.cre to xgtanadv (XG0020)

COPY_EXISTING ~tanadv03.cre~			~override/xgtanadv.cre~
	WRITE_ASCII 0x280 ~xgtanadv~ (8) // Script name / Death variable
	WRITE_ASCII 0x2CC ~None~ (8) // Dialog name


// New actor in ducal palace if game is EET/BGT	

	ACTION_IF GAME_IS ~bgt eet~ BEGIN
		COPY_EXISTING ~FLAM10.CRE~			~override/XGFLAM10.CRE~
			SAY NAME1 @210
			SAY NAME2 @210
			WRITE_ASCII 0x280 ~XGFLAM10~ (13) // Script name / Death variable
			WRITE_ASCII 0x2CC ~XGFLAM10~ (8) // Dialog name
			WRITE_ASCII 0x250 ~XGFLAM10~ (8) // Class script
	END


