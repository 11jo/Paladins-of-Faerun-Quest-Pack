@1 = ~Don't kill me, please!~
@2 = ~I did not come here to kill you. What are you doing here?~
@3 = ~You seem familiar... Someone kidnapped me and keeps me here. ~
@4 = ~You are free girl. Can you get to the captain of the city guard yourself?~
@5 = ~Yes, I guess...~
@6 = ~This place is not suited for a child, stay close to me !~
@7 = ~Yes, thank you.~
