// To XGBRMOC.d

/*
@0 = ~Ah, <CHARNAME> ! Nous nous rencontrons enfin, j'attends ce moment depuis longtemps, te retrouver toi et ton groupe a toujours était mon objectif... Afin de venger la mort de ton frère, Sarevok ! Et aujourd'hui, le temps est venu !~
@1 = ~Bien entendu, tu es venu pour Gradak et cette relique magique que je lui ai donnée. Lui aussi désir ton trépas et je ne compte pas le décevoir !~ ~Bien entendu, tu es venue pour Gradak et cette relique magique que je lui ai donnée. Lui aussi désir ton trépas et je ne compte pas le décevoir !~
@2 = ~Si vous acceptez de me révéler sa destination, vous serez le seul à être appréhendé et vos ouailles bénéficieront d'un traitement de faveur.~
@3 = ~Tu ne rattraperas pas Gradak, même si tu arrives à nous terrasser, moi ainsi que tous mes frères ! Tu ne le retrouveras jamais !!!~
@4 = ~Parviendras-tu à vaincre mes fidèles et à me rejoindre de l'autre côté ? Seras-tu digne de te battre contre moi ? Nous le verrons bien assez tôt !~
*/

@5 = ~Nous avons été envoyés ici pour vous aider ! 
<CHARNAME> et son groupe sont sous notre protection !~

@6 = ~C'est terminé... Il est temps de retourner voir le Duc Opas.~