@0 = ~Je t'ai jamais vu toi... Tu connais le mot de passe ?~ 
@1 = ~Oui, évidemment !~
@2 = ~Pas la moindre idée.~
@3 = ~Bouge de là ou je te passe sur le corps.~
@4 = ~Alors dégage et ne reviens pas sans le mot de passe.~
@5 = ~Très bien, je reviendrais.~
@6 = ~Voyons ça ! Quel est le premier des trois ?~ 
@7 = ~Ombre.~
@8 = ~Pièces d'or.~
@9 = ~Coeur brisé.~
@10 = ~Deux sabres.~
@11 = ~Brouillard.~
@12 = ~Donjon.~
@13 = ~Boutique.~
@14 = ~Piège.~
@15 = ~Esclave.~ // Slave.
@16 = ~Lumière.~
@17 = ~Bien, mais il ne faut rien laisser au hasard... Le second et vite !~
@18 = ~Marché.~ // Market.
@19 = ~Eauprofonde.~
@20 = ~Esclavagistes.~
@21 = ~Sentinelle.~
@22 = ~Meurtrier.~
@23 = ~Taverne.~
@24 = ~Hum ! Tu semble dans la confidence... Le dernier t'ouvriras la voie ou ... la gorge.~
@25 = ~Bleu.~
@26 = ~Blanc.~
@27 = ~Rouge.~
@28 = ~Noir.~ // Black.
@29 = ~Marron.~
@30 = ~Vert.~
@31 = ~Bienvenu dans la guilde, le passage est ouvert.~