@1 = ~Tötet mich nicht, bitte!~
@2 = ~Ich bin nicht hier, um Euch zu töten. Was tut Ihr hier?~
@3 = ~You seem familiar... Jemand hat mich entführt und hält mich hier fest.~
@4 = ~Ihr seid ein freies Mädchen. Könnt Ihr selbst zum Hauptmann der Stadtwache gehen?~
@5 = ~Ja, danke, Fremder.~ ~Ja, danke, Fremde.~
@6 = ~This place is not suited for a child, stay close to me !~
@7 = ~Yes, thank you.~
