IF
	True()
	Global("EnteredAR0602","AR0602",0)
THEN
	RESPONSE #100
		SetGlobal("EnteredAR0602","AR0602",1)
		ClearAllActions()
		StartCutSceneMode()
		HideGUI()
	// Explore()
	FadeToColor([50.0],0)
	CreateCreature("XGJONW",[3746.1998],10)
	ActionOverride("XGJONW",ChangeEnemyAlly(Myself,NEUTRAL))
	CreateCreature("XGJOWC",[3686.1869],14)
	ActionOverride("XGJOWC",ChangeEnemyAlly(Myself,NEUTRAL))
	CreateCreature("XGIRENM",[3967.2030],7)
	ActionOverride("XGIRENM",ChangeEnemyAlly(Myself,NEUTRAL))
	CreateCreature("XGJON",[3876.1870],1)
	ActionOverride("XGJON",ChangeEnemyAlly(Myself,NEUTRAL))
	CreateCreature("XGNPC4",[3658.1987],10)
	CreateCreature("XGIMOEN",[3610.1697],14)
	Wait(2)
	MoveViewPoint([3873.1762],INSTANT)
	MultiPlayerSync()
	Wait(1)
	FadeFromColor([20.0],0)
	Wait(3)	
	DisplayStringHead("XGJON",@0)
	Wait(6)
	DisplayStringHead("XGNPC4",@1)
	Wait(7)
	DisplayStringHead("XGNPC4",@7)
	Wait(6)
	DisplayStringHead("XGJON",@2)
	Wait(7)
	DisplayStringHead("XGJON",@11)
	Wait(4)
	DisplayStringHead("XGJON",@8)
	Wait(6)
	DisplayStringHead("XGJONW",@3)
	Wait(2)
	DisplayStringHead("XGIMOEN",@4)
	// MoveViewPoint([3908.2001],SLOW)
	Wait(3)
	ActionOverride("XGJON",MoveToPointNoInterrupt([4133.1768]))
	ActionOverride("XGNPC4",MoveToPointNoInterrupt([3732.1917]))
	ActionOverride("XGJON",MoveToPointNoInterrupt([4141.1643]))
	ActionOverride("XGNPC4",MoveToPointNoInterrupt([3962.1843]))
	Wait(3)
	ActionOverride("XGJON",FaceObject("XGNPC4"))
	Wait(1)
	DisplayStringHead("XGNPC4",@5)
	Wait(6)
	ActionOverride("XGIRENM",Spell("XGNPC4",WIZARD_MAGIC_MISSILE))
	Wait(1)
	ActionOverride("XGJON",MoveToPointNoInterrupt([4220.1528]))
	// ActionOverride("XGNPC4",MoveToPoint([3923.1883]))
	ActionOverride("XGNPC4",FaceObject("XGIRENM"))
	Wait(2)
	ActionOverride("XGJON",DestroySelf())
	ActionOverride("XGNPC4",SetSequence(SEQ_READY))
	// MoveViewPoint([3879.1882],INSTANT)
	DisplayStringHead("XGNPC4",@9)
	Wait(6)
	ActionOverride("XGJONW",MoveToPoint([3851.1888]))
	ActionOverride("XGNPC4",SetSequence(SEQ_READY))
	ActionOverride("XGNPC4",MoveToObject("XGJONW"))
	ActionOverride("XGIRENM",UseItem("SCRL62","XGNPC4"))
	Wait(4)
	DisplayStringHead("XGNPC4",@10)
	ActionOverride("XGNPC4",SetSequence(SEQ_READY))
	Wait(1)
	ActionOverride("XGNPC4",Attack("XGJONW"))
	Wait(2)
	ActionOverride("XGJONW",Attack("XGNPC4"))
	SmallWait(1)
	ActionOverride("XGIRENM",MoveToPointNoInterrupt([3674.2024]))
	ActionOverride("XGIRENM",FaceObject("XGNPC4"))
	Wait(3)
	ActionOverride("XGJOWC",Attack("XGNPC4"))
	SmallWait(1)
	Wait(3)
	ActionOverride("XGJONW",PlayDead(100000))
	Wait(1)
	ActionOverride("XGNPC4",Attack("XGJOWC"))
	Wait(5)
	ActionOverride("XGJOWC",PlayDead(100000))
	SmallWait(1)
	ActionOverride("XGIRENM",Spell("XGNPC4",WIZARD_FINGER_OF_DEATH_IGNORE_RESISTANCE))
	Wait(1)
	ActionOverride("XGNPC4",Attack("XGIRENM"))
	Wait(3)
	ActionOverride("XGIRENM",Kill("XGNPC4"))
	// DisplayStringHead("XGNPC4",#4046) // Mère de sûreté !
	// DisplayStringHead("XGNPC4",#4083) // Jah... Jah-Jaheira. Non ! NOOOOOON !
	Wait(1)
	ActionOverride("XGIRENM",MoveToPoint([3388.2265]))
	// MoveViewPoint([3604.1846],STANDARD)
	DisplayStringHead("XGIMOEN",@6)
	Wait(7)
	FadeToColor([50.0],0)
	Wait(3)
	ActionOverride("XGIMOEN",DestroySelf())
	ActionOverride("XGJONW",DestroySelf())
	ActionOverride("XGJOWC",DestroySelf())
	ActionOverride("XGIRENM",DestroySelf())
	// MoveViewObject("XGNPC4",SLOW)
	FadeFromColor([50.0],0)
	Wait(5)
	FadeToColor([50.0],0)
	Wait(3)
		UnhideGUI()
		EndCutSceneMode()
	ActionOverride("XGNPC4",DestroySelf())
	MoveViewPoint([3740.2799],INSTANT)
	ActionOverride(Protagonist,Explore())
	MultiPlayerSync()
		Continue()
END
