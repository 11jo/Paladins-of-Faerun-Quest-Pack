IF
	OR(2)
		Entered([ANYONE])
		Opened([ANYONE])
THEN
	RESPONSE #100
		DisplayString(LastTrigger,#14381)  // Piège activé
		Wait(2)
		DisplayStringHead(LastTrigger,@1011)  //
		ForceSpell(LastTrigger,WIZARD_RAY_OF_ENFEEBLEMENT)  // SPWI221.SPL (Rayon débilitant)
		ForceSpell(NearestAllyOf(LastTrigger),WIZARD_FEEBLEMIND)  // SPWI509.SPL (Débilité mentale)
END

