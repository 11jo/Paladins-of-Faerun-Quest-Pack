IF
	Global("RevealXG0150","XG0150",1)
	Global("s#XGCRU","GLOBAL",1)
	Dead("XGCRU")
THEN
	RESPONSE #100
		ClearAllActions()
		StartCutSceneMode()
		HideGUI()
		SetGlobal("s#XGCRU","GLOBAL",2)
		SetGlobal("RevealXG0150","XG0150",2)
		CreateCreature("XGBAN1A",[2294.787],0)
		ActionOverride("XGBAN1A",MoveToPoint([2085.972]))
		CreateCreature("XGBAN1B",[1579.709],0)
		Wait(2)
		ActionOverride(Player1,MoveToPoint([2029.1031]))
		Wait(2)
		ActionOverride("XGBAN1B",MoveToPoint([1880.955]))
		MoveViewPoint([2099.980],INSTANT)
		Wait(1)
		DisplayStringHead("XGBAN1A",@0) 
		Wait(7)
		DisplayStringHead("XGBAN1A",@13)  
		UnhideGUI() 
		EndCutSceneMode()
END
