IF
	Global("RevealXG0150","XG0150",0)
	Dead("XGCRU")
THEN
	RESPONSE #100
		SetGlobal("RevealXG0150","XG0150",2)
		ClearAllActions()
		StartCutSceneMode()
		HideGUI()
		Explore()
		Wait(2)
		CreateCreature("XGBAN1A",[2294.787],0)
		ActionOverride("XGBAN1A",MoveToPoint([2085.972]))
		Wait(2)
		ActionOverride(Player1,MoveToPoint([2029.1031]))
		Wait(2)
		MoveViewPoint([2099.980],INSTANT)
		Wait(1)
		DisplayStringHead("XGBAN1A",@0)  
		Wait(7)
		DisplayStringHead(Player1,@1)  
		Wait(5)
		CreateVisualEffectObject("SPDIMNDR","XGBAN1A") 
		Wait(2)
		ActionOverride("XGBAN1A",MoveBetweenAreas("XG0150",[1708.738],12))
		Wait(1)
		CreateCreature("XGBAN1B",[1717.723],0)
		SmallWait(1)
		CreateCreature("XGMAYW",[1648.663],0)
		SmallWait(1)
		CreateCreature("XGMAYB",[1612.703],0)
		Wait(1)
		ActionOverride("XGBAN1A",MoveToPoint([2017.921]))
		SmallWait(1)
		ActionOverride("XGMAYW",MoveToPoint([1986.999]))
		SmallWait(1)
		ActionOverride("XGMAYB",MoveToPoint([1917.1004]))
		Wait(1)
		ActionOverride("XGBAN1B",MoveToPoint([1793.942]))
		Wait(5)
		DisplayStringHead(Player1,@2) 
//DisplayStringHead("XGBLMAJ",@3)  
		ActionOverride("XGBAN1A",MoveToPoint([2085.972]))
		Wait(3)
		ActionOverride(Player1,Face(10))
		Wait(1)
		DisplayStringHead("XGBAN1A",@13)
		Wait(4)
	/*
// See XGBAN1A.d

	Wait(1)
    DisplayStringHead("XGBAN1A",@4)  
    Wait(7)
    DisplayStringHead(Player1,@5)  
    Wait(8)
    DisplayStringHead("XGBAN1A",@6)
	*/
		FadeToColor([20.0],0)
		Wait(2)
		ActionOverride("XGMAYW",MoveBetweenAreas("XG0720",[1000.790],0))
		SmallWait(2)
		ActionOverride("XGMAYB",MoveBetweenAreas("XG0720",[1000.770],0))
		SmallWait(2)
		ActionOverride(Player1,LeaveAreaLUA("XG0720","",[1000.750],0))
		ActionOverride(Player2,LeaveAreaLUA("XG0720","",[1034.643],0))
		ActionOverride(Player3,LeaveAreaLUA("XG0720","",[1144.720],0))
		ActionOverride(Player4,LeaveAreaLUA("XG0720","",[956.718],0))
		ActionOverride(Player5,LeaveAreaLUA("XG0720","",[1054.796],0))
		ActionOverride(Player6,LeaveAreaLUA("XG0720","",[1048.737],0))
		EndCutSceneMode()
END

