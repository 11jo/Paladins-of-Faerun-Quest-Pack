IF
	AreaCheck("XG0152")
	!AreaCheck("XG0052")
	Global("s#XGELOR_XGARJUN","GLOBAL",0)
	Global("NEUTRALONCE_XGARJUN","LOCALS",0)
THEN
	RESPONSE #100
		//SetGlobal("s#XGELOR_XGARJUN_LOCALS","LOCALS",1)
		SetGlobal("XGARJO_ALLNEUTRAL","GLOBAL",0)
		SetGlobal("XGARJO_ALL","GLOBAL",0)
		SetGlobal("NEUTRALONCE_XGARJUN","LOCALS",1)
		ClearAllActions()
		ChangeEnemyAlly(Myself,NEUTRAL)
		Continue()
END

IF
	!Global("s#XGELOR_XGARJUN","GLOBAL",0)
OR(4)
	Global("s#XGELOR_XGARJUN","GLOBAL",5)
	AttackedBy([GOODCUTOFF],DEFAULT)
	Global("RESETTRAP_XGARJUN","GLOBAL",1)
	Global("XGARJO_ALL","GLOBAL",1)
THEN
	RESPONSE #100
		//SetGlobal("s#XGELOR_XGARJUN_LOCALS","LOCALS",0)
		SetGlobal("RESETTRAP_XGARJUN","GLOBAL",1)
		SetGlobal("XGARJO_ALL","GLOBAL",1)
		Enemy()
END

IF
	Global("XGARJO_ALLNEUTRAL","GLOBAL",0)
	Global("s#XGELOR_XGARJUN","GLOBAL",0)
OR(2)
	AttackedBy([GOODCUTOFF],DEFAULT)
	Global("XGARJO_ALL","GLOBAL",1)
THEN
	RESPONSE #100
		//SetGlobal("s#XGELOR_XGARJUN_LOCALS","LOCALS",0)
		SetGlobal("XGARJO_ALL","GLOBAL",1)
		SetGlobal("XGARJO_ALLNEUTRAL","GLOBAL",1)
		Enemy()
END

IF
	Global("s#XGELOR_XGARJUN","GLOBAL",1)
	Global("s#XGELOR_XGARJUN_LOCALS","LOCALS",0)
THEN
	RESPONSE #100
		ClearAllActions()
		ChangeEnemyAlly(Myself,NEUTRAL)
		SetGlobal("XGARJO_ALL","GLOBAL",0)
		SetGlobal("XGARJO_ALLNEUTRAL","GLOBAL",0)
		SetGlobal("s#XGELOR_XGARJUN_LOCALS","LOCALS",1)
		Continue()
END

