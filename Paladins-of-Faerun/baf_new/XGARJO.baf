IF
	!Global("s#XGELOR_XGARJUN","GLOBAL",0)
OR(2)
	Global("s#XGELOR_XGARJUN","GLOBAL",5)
	AttackedBy([GOODCUTOFF],DEFAULT)
THEN
	RESPONSE #100
		SetGlobal("s#XGELOR_XGARJUN","GLOBAL",5)
		SetGlobal("s#XGELOR_XGARJUN_LOCAL","LOCAL",0)
		Enemy()
END

IF
	Global("s#XGELOR_XGARJUN","GLOBAL",1)
	Global("s#XGELOR_XGARJUN_LOCAL","LOCAL",0)
THEN
	RESPONSE #100
		ClearActions(Myself)
		ChangeEnemyAlly(Myself,NEUTRAL)
		SetGlobal("s#XGELOR_XGARJUN_LOCAL","LOCAL",1)
END
