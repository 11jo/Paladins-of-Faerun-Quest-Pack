IF
	InMyArea("XGBGG")
	Global("XG1120_XG0020","GLOBAL",2)
	OR(2)
	!Global("XGBGG_Missing","GLOBAL",4)
	Dead("XGBGG")
THEN
  RESPONSE #100
		SetGlobal("XG1120_XG0020","GLOBAL",3)
		SetGlobal("XGBGG_Missing","GLOBAL",8)
		DestroySelf()
END

IF
	Global("XGBGG_XG0020","GLOBAL",0)
	Global("XG1120_XG0020","GLOBAL",2)
	Global("XGBGG_Missing","GLOBAL",4)
	!Dead("XGBGG")
	InMyArea("XGBGG")
THEN
  RESPONSE #100
		ClearAllActions()
		StartCutSceneMode()
		SetGlobal("XG1120_XG0020","GLOBAL",3)
		SetGlobal("XGBGG_XG0020","GLOBAL",1)
		//DestroyItem("IMPINVIS")
		MoveViewObject(Player1,INSTANT)
		HideGUI()
		ChangeEnemyAlly(Myself,NEUTRAL)
		Wait(1)
		DisplayStringHead("XGBGG",@1058)
		Wait(3)
		DisplayStringHead("XGBGG",@1059)
		Wait(1)
		ReputationInc(1)
		UnhideGUI()
		EndCutSceneMode()
END

IF
	Global("XGBGG_XG0020","GLOBAL",1)
	InMyArea("XGFLAM12")
	!Range("XGFLAM12",6)
THEN
  RESPONSE #100
		MoveToObjectNoInterrupt("XGFLAM12")
END

IF
	Global("XGBGG_XGBGFL00","MYAREA",1)
THEN
  RESPONSE #100
		SetGlobal("XGBGG_XGBGFL00","MYAREA",0)
		DisplayStringHead("XGBGG",#42032)
END

IF
	Global("XGBGG_XG0020","GLOBAL",1)
	InMyArea("XGFLAF12")
	!Range("XGFLAF12",6)
THEN
  RESPONSE #100
		MoveToObjectNoInterrupt("XGFLAF12")
END

IF
	Allegiance(Myself,ALLY)
	AreaCheck("XG1120")
	!See([GOODCUTOFF])
THEN
  RESPONSE #100
		Wait(1)
		MoveToObject(Player1)
END

IF
	Allegiance(Myself,ALLY)
	AreaCheck("XG1120")
	Range(Player1,3)
	See([GOODCUTOFF])	
	InMyArea(Player2)
	!Range(Player2,3)
THEN
  RESPONSE #100
		Wait(1)
		MoveToObject(Player2)
