IF
	!InMyArea("XGFLAF12")
	!InMyArea("XGFLAM12")
OR(2)
	AreaCheck("XG0020")
	AreaCheck("%NBaldursGate%")
THEN
  RESPONSE #100
		EscapeArea()
END

