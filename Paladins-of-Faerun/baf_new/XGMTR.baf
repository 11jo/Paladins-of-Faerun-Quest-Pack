IF
	See([GOODCUTOFF])
	Global("XGMTR_SHOUT","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("XGMTR_SHOUT","LOCALS",1)
		DisplayStringHead(Myself,@3003)
		FaceObject(Player1)
		Wait(10)
		DisplayStringHead(Myself,@3003)
		FaceObject(Player6)
		Wait(10)
		DisplayStringHead(Myself,@3003)
		FaceObject(Player2)
		Wait(10)
		DisplayStringHead(Myself,@3003)
		FaceObject(Player5)
		Wait(10)
		DisplayStringHead(Myself,@3003)
		FaceObject(Player3)
		Wait(10)
		DisplayStringHead(Myself,@3003)
		FaceObject(Player4)
		Continue()
END

IF
	Global("XGMTR_SHOUT","LOCALS",1)
	Delay(20)
THEN
	RESPONSE #100
		SetGlobal("XGMTR_SHOUT","LOCALS",0)
		Continue()
END

