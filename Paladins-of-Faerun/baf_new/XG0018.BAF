		CreateCreature("XGYARPW",[1148.967],0) 
		CreateCreature("XGYARPW",[1174.1083],0)
		CreateCreature("XGYARPW",[1278.1086],0)
		CreateCreature("XGYARPW",[1285.1014],0)
		CreateCreature("XGYARPW",[1284.937],0) 
