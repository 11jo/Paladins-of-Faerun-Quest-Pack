		CreateCreature("XGYARPA",[1435.783],0) 
		CreateCreature("XGYARPA",[1538.795],0) 
		CreateCreature("XGYARPA",[1688.821],0) 
		CreateCreature("XGYARPA",[1711.750],0) 
