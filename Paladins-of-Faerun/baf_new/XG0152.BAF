IF
	Global("RESETTRAP_XGARJUN","GLOBAL",1)
	Global("RESETONCE_XGARJUN","MYAREA",0)
THEN
	RESPONSE #100
		SetGlobal("RESETONCE_XGARJUN","MYAREA",1)
		TriggerActivation("Trigger Point 9",TRUE)
		TriggerActivation("Trigger Point 10",TRUE)
		TriggerActivation("Trigger Point 11",TRUE)
		TriggerActivation("Trigger Point 12",TRUE)
		TriggerActivation("Trigger Point 13",TRUE)
		TriggerActivation("Trigger Point 14",TRUE)
		TriggerActivation("Trigger Point 15",TRUE)
		TriggerActivation("Trigger Point 16",TRUE)
		TriggerActivation("Trigger Point 17",TRUE)
		TriggerActivation("Trigger Point 18",TRUE)
		TriggerActivation("Trigger Point 19",TRUE)
		TriggerActivation("Trigger Point 20",TRUE)
		TriggerActivation("Trigger Point 21",TRUE)
		TriggerActivation("Trigger Point 22",TRUE)
		TriggerActivation("Trigger Point 23",TRUE)
		TriggerActivation("Trigger Point 24",TRUE)
		TriggerActivation("Trigger Point 25",TRUE)
		Continue()
END
