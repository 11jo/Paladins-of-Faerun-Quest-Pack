IF
	Global("XGLORD_POP","GLOBAL",0)
	OpenState("CRYPT01",TRUE)
THEN
	RESPONSE #100
    ClearAllActions()
    StartCutSceneMode()
    HideGUI()
	FadeToColor([30.0],0)
	Wait(2)
	SetGlobal("XGLORD_POP","GLOBAL",1)
	ActionOverride(Player2,LeaveAreaLUA("XG0302","",[758.2776],0))
    ActionOverride(Player1,LeaveAreaLUA("XG0302","",[824.2827],0))
    ActionOverride(Player3,LeaveAreaLUA("XG0302","",[743.2827],0))
    ActionOverride(Player4,LeaveAreaLUA("XG0302","",[666.2846],0))
    ActionOverride(Player5,LeaveAreaLUA("XG0302","",[670.2874],0))
    ActionOverride(Player6,LeaveAreaLUA("XG0302","",[721.2909],0))
	LeaveAreaLUA("XG0302","",[825.2767],0)
	Wait(1)
	ActionOverride(Player2,FaceObject("XGLORD"))
    ActionOverride(Player1,FaceObject("XGLORD"))
    ActionOverride(Player3,FaceObject("XGLORD"))
    ActionOverride(Player4,FaceObject("XGLORD"))
    ActionOverride(Player5,FaceObject("XGLORD"))
    ActionOverride(Player6,FaceObject("XGLORD"))
	FaceObject(Player1)
	FadeFromColor([20.0],0)
	Wait(3)
    UnhideGUI()
    EndCutSceneMode()
END
