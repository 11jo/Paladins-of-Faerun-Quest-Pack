IF
  OnCreation()
  Global("EnteredXG0019","XG0019",0)
THEN
  RESPONSE #100
    SetGlobal("EnteredXG0019","XG0019",1)
    ClearAllActions()
    StartCutSceneMode()
    HideGUI()
    Wait(2)
    ActionOverride("XGYARPN",FaceObject(Player1))
    Wait(2)
    DisplayString("XGYARPN",@0)  // @0
    Wait(3)
    ActionOverride("XGYARPN",EscapeArea())
    RevealAreaOnMap("XG0319")
    Wait(2)
    UnhideGUI()
    EndCutSceneMode()
END
