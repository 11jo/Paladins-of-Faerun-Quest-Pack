BEGIN ~XGBGPS1~

IF ~Global("XGBGPS1","GLOBAL",0)
OR(2)
	PartyHasItem("XGZAT")
	PartyHasItem("XGZAT1")~ THEN BEGIN 0
  SAY @1
  IF ~~ THEN REPLY @2 GOTO 1
END

IF ~~ THEN BEGIN 1
  SAY @3
  IF ~~ THEN DO ~SetGlobal("XGBGPS1","GLOBAL",1)~ EXIT
END

IF ~!Global("XG1120_XG0020","GLOBAL",2) Global("XGBGPS1","GLOBAL",1)~ THEN BEGIN 3
  SAY @3
  IF ~~ THEN EXIT
END

IF ~Global("XG1120_XG0020","GLOBAL",2)~ THEN BEGIN 4
  SAY @4
  IF ~~ THEN EXIT
END

IF ~!Global("XG1120_XG0020","GLOBAL",2)
!PartyHasItem("XGZAT")
!PartyHasItem("XGZAT1")~ THEN BEGIN 2
  SAY #29945
  IF ~~ THEN EXIT
END
