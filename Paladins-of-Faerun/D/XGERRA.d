BEGIN ~XGERRA~

IF WEIGHT #0 ~NumTimesTalkedTo(0)~ THEN BEGIN 0
  SAY @1
  IF ~~ THEN REPLY @2 GOTO 1
END

IF ~~ THEN BEGIN 1
  SAY @3
  IF ~~ THEN REPLY @4 GOTO 2
END

IF ~~ THEN BEGIN 2
  SAY @5
  IF ~~ THEN DO ~AddJournalEntry(@51601,QUEST)~ EXIT
END

IF WEIGHT #2 ~!PartyHasItem("XGERKEY")~ THEN BEGIN 3
  SAY @7
  IF ~~ THEN REPLY @8 EXIT
END

IF WEIGHT #1 ~PartyHasItem("XGERKEY")~ THEN BEGIN 4
  SAY @7
  IF ~~ THEN REPLY @9 GOTO 5
END

IF ~~ THEN BEGIN 5
  SAY @10
  IF ~~ THEN REPLY @12 DO ~EraseJournalEntry(@51601)
AddexperienceParty(6000)
TakePartyItem("XGERKEY")
AddJournalEntry(@51602,QUEST_DONE)
EscapeArea()
~ EXIT
END
