     APPEND_FILE ~Paladins-of-Faerun/Worldmap/areas.tbl~

    COPY ~Worldmap/map_mods_links.tbl~		~Worldmap~
     APPEND_FILE ~weidu_external/Paladins-of-Faerun/Worldmap/links.tbl~

