////////////////////////////////////////////////////////////////////
//BG2 BG2EE

	ACTION_IF NOT GAME_IS ~bgt eet~ AND FILE_EXISTS ~Worldmap/map_mods_areas.tbl~ THEN BEGIN

    COPY ~Worldmap/map_mods_areas.tbl~		~Worldmap~
     APPEND_FILE ~Paladins-of-Faerun/Worldmap/areas.tbl~

    COPY ~Worldmap/map_mods_links.tbl~		~Worldmap~
     APPEND_FILE ~Paladins-of-Faerun/Worldmap/links.tbl~

    COPY ~Worldmap/map_mods_trans.tra~		~Worldmap~
     APPEND_FILE_EVALUATE ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/worldmap.tra~

  END ELSE ACTION_IF NOT GAME_IS ~bgt eet~ AND NOT FILE_EXISTS ~Worldmap/map_mods_areas.tbl~ BEGIN

	MKDIR ~Worldmap~

	COPY ~Paladins-of-Faerun/Worldmap/areas.tbl~			~Worldmap/map_mods_areas.tbl~

	COPY ~Paladins-of-Faerun/Worldmap/links.tbl~			~Worldmap/map_mods_links.tbl~

	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/worldmap.tra~	~Worldmap/map_mods_trans.tra~

  END
END

////////////////////////////////////////////////////////////////////
//BGT EET

	ACTION_IF GAME_IS ~bgt eet~ AND FILE_EXISTS ~Worldmap/map_mods_areas.tbl~ THEN BEGIN

