END
*/

//////////////////////////////////
// Worldmap
//////////////////////////////////

	ACTION_IF FILE_EXISTS ~Worldmap/map_mods_areas.tbl~ THEN BEGIN

		COPY ~Worldmap/map_mods_areas.tbl~		~Worldmap~
			APPEND_FILE ~Paladins-of-Faerun/Worldmap/areas.tbl~

			/*	ACTION_IF GAME_IS ~bgt eet~ BEGIN
		COPY ~Worldmap/map_mods_links.tbl~		~Worldmap~
			APPEND_FILE ~weidu_external/Paladins-of-Faerun/Worldmap/links.tbl~
				END ELSE BEGIN	*/
		COPY ~Worldmap/map_mods_links.tbl~		~Worldmap~
			APPEND_FILE ~Paladins-of-Faerun/Worldmap/links.tbl~
			/*	END	*/

		COPY ~Worldmap/map_mods_trans.tra~		~Worldmap~
			APPEND_FILE_EVALUATE ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/worldmap.tra~

	END ELSE BEGIN

		MKDIR ~Worldmap~

		COPY ~Paladins-of-Faerun/Worldmap/areas.tbl~							~Worldmap/map_mods_areas.tbl~

			/*	ACTION_IF GAME_IS ~bgt eet~ BEGIN
		COPY ~weidu_external/Paladins-of-Faerun/Worldmap/links.tbl~			~Worldmap/map_mods_links.tbl~
				END ELSE BEGIN	*/
		COPY ~Paladins-of-Faerun/Worldmap/links.tbl~							~Worldmap/map_mods_links.tbl~
		/*	END	*/

		COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/worldmap.tra~	~Worldmap/map_mods_trans.tra~

	END

// Append mastarea.2da with the new areas
	APPEND ~MASTAREA.2da~ ~XG0001 value~ UNLESS ~XG0001~ // Grotte des Marchands // Tradmith Cave //
	APPEND ~MASTAREA.2da~ ~XG0002 value~ UNLESS ~XG0002~ // Plaines Étincelantes // The Shining Plains //
	APPEND ~MASTAREA.2da~ ~XG0003 value~ UNLESS ~XG0003~ // Bois de Turlang // Turlan Forest //
