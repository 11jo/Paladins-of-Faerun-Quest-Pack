////// Worldmap link for EET/BGT

// This addition allow to acces BG2 city gate in BG1, so don't do it !

/*
ACTION_IF GAME_IS ~eet~ AND FILE_EXISTS ~Paladins-of-Faerun/Worldmap/links.tbl~ BEGIN
			PRINT ~Link between Aeras for EET~
	COPY_EXISTING ~Paladins-of-Faerun/Worldmap/links.tbl~	~weidu_external/Paladins-of-Faerun/Worldmap/links.tbl~
		REPLACE_TEXTUALLY	~XG0020~	~BG0200~
	//	REPLACE_TEXTUALLY	~XG0120~	~BG0119~ // Useless
	//	REPLACE_TEXTUALLY	~XG0820~	~BG0121~ // Useless
