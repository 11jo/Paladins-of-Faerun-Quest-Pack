  END ELSE ACTION_IF GAME_IS ~bgt eet~ AND NOT FILE_EXISTS ~Worldmap/map_mods_areas.tbl~ BEGIN

	MKDIR ~Worldmap~

	COPY ~Paladins-of-Faerun/Worldmap/areas.tbl~							~Worldmap/map_mods_areas.tbl~

	COPY ~weidu_external/Paladins-of-Faerun/Worldmap/links.tbl~			~Worldmap/map_mods_links.tbl~

	COPY ~weidu_external/Paladins-of-Faerun/Languages/autotra/%LANGUAGE%/worldmap.tra~	~Worldmap/map_mods_trans.tra~

