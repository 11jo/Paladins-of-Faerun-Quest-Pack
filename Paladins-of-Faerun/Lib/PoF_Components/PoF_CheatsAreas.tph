	~\({"XG0020",.*"},\)~                             => 100007
	~\({"XG0120",.*"},\)~                             => 100008
	~\({"XG0820",.*"},\)~                             => 100009
	~\({"XG0520",.*"},\)~                             => 100010
	~\({"XG0620",.*"},\)~                             => 100011
	~\({"XG0320",.*"},\)~                             => 100012

END

    PATCH_PHP_EACH strings_pof_bgt AS find => replace_ref BEGIN
        SPRINT replace (AT replace_ref)
        REPLACE_TEXTUALLY ~%find%~ ~%replace%~
    END
END

