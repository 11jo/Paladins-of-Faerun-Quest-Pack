ACTION_IF FILE_EXISTS_IN_GAME ~bgee.lua~ BEGIN
	PRINT ~Aeras cheat for Paladin of Faerun~
	COPY_EXISTING ~bgee.lua~ ~override/bgee.lua~

	// CheatsAreas pour Paladin of Faerun
	PATCH_DEFINE_ASSOCIATIVE_ARRAY strings_pof BEGIN
	~{"OH7200", "Hexxat - Bottom Right Quarter (Zakhara)"},~                             => 100000

END

    PATCH_PHP_EACH strings_pof AS find => replace_ref BEGIN
        SPRINT replace (AT replace_ref)
        REPLACE_TEXTUALLY ~%find%~ ~%replace%~
    END
END

ACTION_IF GAME_IS ~eet~ AND FILE_EXISTS_IN_GAME ~bgee.lua~ BEGIN
	PRINT ~Aeras cheat for Paladin of Faerun EET~
	COPY_EXISTING ~bgee.lua~ ~override/bgee.lua~

	// CheatsAreas pour Paladin of Faerun
	PATCH_DEFINE_ASSOCIATIVE_ARRAY strings_pof_eet BEGIN
	~\({"XG0020",.*"},\)~                             => 100001
	~\({"XG0120",.*"},\)~                             => 100002
	~\({"XG0820",.*"},\)~                             => 100003
	~\({"XG0520",.*"},\)~                             => 100004
	~\({"XG0620",.*"},\)~                             => 100005
	~\({"XG0320",.*"},\)~                             => 100006

END

    PATCH_PHP_EACH strings_pof_eet AS find => replace_ref BEGIN
        SPRINT replace (AT replace_ref)
        REPLACE_TEXTUALLY ~%find%~ ~%replace%~
    END
END

ACTION_IF GAME_IS ~bgt~ AND FILE_EXISTS_IN_GAME ~bgee.lua~ BEGIN
	PRINT ~Aeras cheat for Paladin of Faerun BGT~
	COPY_EXISTING ~bgee.lua~ ~override/bgee.lua~

