
//////////////////////////////////
// Setup Actors
//////////////////////////////////

MKDIR ~weidu_external/Paladins-of-Faerun/Actors~

// Items on CREATURES
ACTION_BASH_FOR ~Paladins-of-Faerun/Actors~ ~^.+$~ BEGIN

PRINT ~         ~
PRINT ~START item on creature~
PRINT ~         ~

COPY ~%BASH_FOR_FILESPEC%~ ~weidu_external/%BASH_FOR_FILESPEC%~
	LPM UPDATE_POF_ITEM_NAMES_ON_CRE // Item-macros.tpa

PRINT ~         ~
PRINT ~END item on creature~
PRINT ~         ~

END

// Script name / Death variable
ACTION_BASH_FOR ~weidu_external/Paladins-of-Faerun/Actors~ ~^.+$~ BEGIN

PRINT ~         ~
PRINT ~START Death variable name on creature~
PRINT ~         ~

COPY ~%BASH_FOR_FILESPEC%~ ~%BASH_FOR_FILESPEC%~
	LPM UPDATE_POF_DEATH_NAMES_ON_CRE // Creature-macros.tpa

PRINT ~         ~
PRINT ~END Death variable name on creature~
PRINT ~         ~

END

// Dlg name
ACTION_BASH_FOR ~weidu_external/Paladins-of-Faerun/Actors~ ~^.+$~ BEGIN

PRINT ~         ~
PRINT ~START Dlg name on creature~
PRINT ~         ~

COPY ~%BASH_FOR_FILESPEC%~ ~%BASH_FOR_FILESPEC%~
	LPM UPDATE_POF_DLG_NAMES_ON_CRE // Creature-macros.tpa

PRINT ~         ~
PRINT ~END Dlg name on creature~
PRINT ~         ~

END

// PORTRAIT L name
ACTION_BASH_FOR ~weidu_external/Paladins-of-Faerun/Actors~ ~^.+$~ BEGIN

PRINT ~         ~
PRINT ~START PORTRAIT L name on creature~
PRINT ~         ~

COPY ~%BASH_FOR_FILESPEC%~ ~%BASH_FOR_FILESPEC%~
	LPM UPDATE_POF_PORTRAITL_NAMES_ON_CRE // Creature-macros.tpa

PRINT ~         ~
PRINT ~END PORTRAIT L name on creature~
PRINT ~         ~

END

// PORTRAIT S name
ACTION_BASH_FOR ~weidu_external/Paladins-of-Faerun/Actors~ ~^.+$~ BEGIN

PRINT ~         ~
PRINT ~START PORTRAIT S name on creature~
PRINT ~         ~

COPY ~%BASH_FOR_FILESPEC%~ ~%BASH_FOR_FILESPEC%~
	LPM UPDATE_POF_PORTRAITS_NAMES_ON_CRE // Creature-macros.tpa

PRINT ~         ~
PRINT ~END PORTRAIT S name on creature~
PRINT ~         ~

END


