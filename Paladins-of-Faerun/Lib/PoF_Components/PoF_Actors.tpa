	WRITE_SHORT 0x26 ~150~ // Maximum HP
	WRITE_SHORT 0x46 ~5~ // Natural AC
	WRITE_SHORT 0x48 ~5~ // Effective AC
	WRITE_BYTE 0x52 ~8~ // THACO
	WRITE_BYTE 0x53 ~2~ // attacks/round 2(2)
	WRITE_BYTE 0x238 ~20~ // Strength
	WRITE_BYTE 0x23c ~19~ // Dexterity
	WRITE_BYTE 0x275 ~2~
	WRITE_BYTE 0x237 ~2~ // Sex
	WRITE_ASCII 0x280 ~XGdrID1~ (8) // Script name / Death variable
	WRITE_LONG 0x28 IDS_OF_SYMBOL ("ANIMATE" "DRIDER_MALE") // ~0xE283~

