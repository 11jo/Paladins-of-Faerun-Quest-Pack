///////////////////////////////////////////////////////////////////////////////

// Cutscene Breakable

///////////////////////////////////////////////////////////////////////////////

IF
	CutSceneBroken()
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetCutSceneBreakable(FALSE)
		ClearAllActions()
		SetGlobal("XG_AR0602_BREAKABLE","GLOBAL",0)
		FadeToColor([0.0],0)
		SetAreaScript("",OVERRIDE)
		SetCutSceneLite(FALSE)
		SetInterrupt(TRUE)
		Continue()
END

///////////////////////////////////////////////////////////////////////////////

// CutSceneBreakable for loading switch

///////////////////////////////////////////////////////////////////////////////

IF
	CutSceneBroken()
	Switch("XG_AR0602_BREAKABLE","GLOBAL")
THEN
	RESPONSE #1
		SetInterrupt(FALSE)
	ActionOverride("XGJON",DestroySelf())
	ActionOverride("XGNEANT4",DestroySelf())
	ActionOverride("XGNEAN28",DestroySelf())
	ActionOverride("XGIMOEN",DestroySelf())
	ActionOverride("XGJONW",DestroySelf())
	ActionOverride("XGJOWC",DestroySelf())
	ActionOverride("XGIRENM",DestroySelf())
	ActionOverride("XGNPC4",DestroySelf())
	ActionOverride(Protagonist,Explore())
	MultiPlayerSync()
	SetGlobal("NewGame","AR0602",1)
		SetInterrupt(TRUE)
END
