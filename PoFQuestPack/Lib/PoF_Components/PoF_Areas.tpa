COPY ~weidu_external/PoFQuestPack/Areas/XG0015.ARE~         ~override/XG0015.ARE~
	LPF fj_are_structure
		INT_VAR
		fj_type			= 1    // Info point
		fj_box_left		= 1655
		fj_box_top		= 340
		fj_box_right	= 1699
		fj_box_bottom	= 400
		fj_cursor_idx	= 22   // curseur ?
		fj_info_point_strref  = RESOLVE_STR_REF (@400)
		fj_loc_x		= 1677
		fj_loc_y		= 370
		fj_vertex_0		= 1656 + (400 << 16)
		fj_vertex_1		= 1699 + (393 << 16)
		fj_vertex_2		= 1699 + (339 << 16)
		fj_vertex_3		= 1655 + (345 << 16)
		fj_vertex_4		= 1656 + (400 << 16)
		STR_VAR
		fj_structure_type	= region
		fj_name				= info01
		END
  ADD_MAP_NOTE #1650 #236 ~gray~ #5386 // maison abandonnée.
  ADD_MAP_NOTE #310 #538 ~red~ @999

// Valid colors include: gray, orange, blue, darkblue, lightgray, RED, YELLOW, GREEN, DEFAULT, 
