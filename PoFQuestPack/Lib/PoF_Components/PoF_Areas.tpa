COPY ~weidu_external/PoFQuestPack/Areas/XG0720.ARE~         ~override/XG0720.ARE~
  WRITE_ASCII 0x94 ~XG0720~ #8
  SAY 0x1170 @428
  SAY 0x1234 @428
  SAY 0x13bc @429
  
  
ACTION_IF GAME_IS ~bgt eet~ BEGIN
	COPY_EXISTING ~XG0720.ARE~ ~override~
		LPF fj_are_structure
			INT_VAR
			fj_type			= 2    // travel
			fj_box_left		= 401
			fj_box_top		= 1373
			fj_box_right	= 521
			fj_box_bottom	= 1564
			fj_cursor_idx	= 30   // 30 door 28 stairs
			fj_loc_x		= 461
			fj_loc_y		= 1468
			fj_vertex_0		= 429 + (1372 << 16)
			fj_vertex_1		= 401 + (1500 << 16)
			fj_vertex_2		= 498 + (1564 << 16)
			fj_vertex_3		= 521 + (1437 << 16)
			fj_vertex_4		= 429 + (1372 << 16)
			STR_VAR
			fj_structure_type	= region
			fj_name				= TravelBG0108
			fj_destination_area	= EVAL ~%NBaldursGate_DucalPalace_L1%~ // Code de la carte
			fj_destination_name	= EntranceBG0108
		END
      LPF fj_are_structure
        INT_VAR
          fj_loc_x = 542
          fj_loc_y = 1413
          //fj_orientation = 0
        STR_VAR
          fj_structure_type = entrance
          fj_name = ExitBG0108
      END
		LPF fj_are_structure
			INT_VAR
			fj_type			= 2    // travel
			fj_box_left		= 401
			fj_box_top		= 1373
			fj_box_right	= 521
			fj_box_bottom	= 1564
			fj_cursor_idx	= 30   // 30 door 28 stairs
			fj_loc_x		= 461
			fj_loc_y		= 1468
			fj_vertex_0		= 429 + (1372 << 16)
			fj_vertex_1		= 401 + (1500 << 16)
			fj_vertex_2		= 498 + (1564 << 16)
			fj_vertex_3		= 521 + (1437 << 16)
			fj_vertex_4		= 429 + (1372 << 16)
			STR_VAR
			fj_structure_type	= region
			fj_name				= TravelXG0720
			fj_destination_area	= XG0020 // Code de la carte
			fj_destination_name	= ExitXG0720
		END
END ELSE BEGIN
	COPY_EXISTING ~XG0720.ARE~ ~override~
		LPF fj_are_structure
			INT_VAR
			fj_type			= 2    // travel
			fj_box_left		= 401
			fj_box_top		= 1373
			fj_box_right	= 521
			fj_box_bottom	= 1564
			fj_cursor_idx	= 30   // 30 door 28 stairs
			fj_loc_x		= 461
			fj_loc_y		= 1468
			fj_vertex_0		= 429 + (1372 << 16)
			fj_vertex_1		= 401 + (1500 << 16)
			fj_vertex_2		= 498 + (1564 << 16)
			fj_vertex_3		= 521 + (1437 << 16)
			fj_vertex_4		= 429 + (1372 << 16)
			STR_VAR
			fj_structure_type	= region
			fj_name				= TravelXG0720
			fj_destination_area	= XG0020 // Code de la carte
			fj_destination_name	= ExitXG0720
		END
END

