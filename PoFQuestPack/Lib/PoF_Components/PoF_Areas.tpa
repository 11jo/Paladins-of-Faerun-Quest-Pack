//ACTION_IF NOT GAME_IS ~bgt eet~ BEGIN

COPY ~weidu_external/PoFQuestPack/Areas/XG0020.ARE~         ~override/XG0020.ARE~
  WRITE_ASCII 0x94 ~XG0020~ #8
  LPF fj_are_structure
    INT_VAR
      fj_variable_value = 1
    STR_VAR
      fj_structure_type = "variable"
      fj_name           = "XGNEWGAME_SOA"
  END
  
//END

ACTION_IF GAME_IS ~bgt eet~ BEGIN

	COPY_EXISTING ~%NBaldursGate%.ARE~			~override/%NBaldursGate%.ARE~
		WRITE_ASCIIE 0x94 ~%NBaldursGate_BCS%~ #8 // Use WRITE_ASCIIE for evaluate the integer
		LPF fj_are_structure
			INT_VAR
			fj_variable_value = 1
			STR_VAR
			fj_structure_type = "variable"
			fj_name           = "POFAREA"
		END  

	COPY_EXISTING ~%NBaldursGate_DucalPalace_L1%.ARE~			~override/%NBaldursGate_DucalPalace_L1%.ARE~
		WRITE_ASCIIE 0x94 ~%NBaldursGate_DucalPalace_L1_BCS%~ #8 // Use WRITE_ASCIIE for evaluate the integer
	LPF fj_are_structure
		INT_VAR
		fj_variable_value = 1
		STR_VAR
		fj_structure_type = "variable"
		fj_name           = "POFAREA"
	END
	LPF fj_are_structure
		INT_VAR
		fj_type			= 2    // travel
		fj_box_left		= 314
		fj_box_top		= 94
		fj_box_right	= 534
		fj_box_bottom	= 284
		fj_cursor_idx	= 28   // 30 door 28 stairs
		fj_info_point_strref  = RESOLVE_STR_REF (@1620)
		fj_loc_x		= 660
		fj_loc_y		= 532
		fj_vertex_0		= 475 + (94 << 16)
		fj_vertex_1		= 423 + (145 << 16)
		fj_vertex_2		= 366 + (191 << 16)
		fj_vertex_3		= 314 + (245 << 16)
		fj_vertex_4		= 374 + (284 << 16)
		fj_vertex_5		= 481 + (190 << 16)
		fj_vertex_6		= 534 + (147 << 16)
		fj_vertex_7		= 534 + (147 << 16)
		fj_vertex_8		= 534 + (146 << 16)
		STR_VAR
		fj_structure_type	= region
		fj_name				= TravelXG0720
		fj_destination_area	= XG0720 // Code de la carte
		fj_destination_name	= ExitBG0108
		END 
	LPF fj_are_structure 
		INT_VAR 
		fj_loc_x = 624 
		fj_loc_y = 236 
		fj_orientation = 14 
		STR_VAR 
		fj_structure_type = actor
		fj_name = "XGFLAM10" 
		fj_cre_resref = "XGFLAM10" 
		fj_dlg_resref = "XGFLAM10"
		fj_bcs_class = ~XGFLAM10~
	END
      LPF fj_are_structure
        INT_VAR
          fj_loc_x = 347
          fj_loc_y = 305
          //fj_orientation = 0
        STR_VAR
          fj_structure_type = entrance
          fj_name = EntranceBG0108
      END
END

