
//////////////////////////////////
// Setup Areas
//////////////////////////////////

/*
MKDIR ~weidu_external/PoFQuestPack/Areas~

ACTION_BASH_FOR ~PoFQuestPack/Areas~ ~^.+$~ BEGIN

PRINT ~         ~
PRINT ~START creature in areas~
PRINT ~         ~

  COPY ~%BASH_FOR_FILESPEC%~ ~weidu_external/%BASH_FOR_FILESPEC%~
    LPM UPDATE_POF_CRE_NAMES_ON_AREA
	// Area-macros.tpa
PRINT ~         ~
PRINT ~END creature in areas~
PRINT ~         ~

END
*/
/*
 // NOT WORKING NOT FOUND YET


ACTION_BASH_FOR ~weidu_external/PoFQuestPack/Areas~ ~^.+$~ BEGIN

PRINT ~         ~
PRINT ~START Containers in areas~
PRINT ~         ~

  COPY ~%BASH_FOR_FILESPEC%~ ~%BASH_FOR_FILESPEC%~
    LPM UPDATE_POF_ITEM_NAMES_ON_CONT
	// Area-macros.tpa
	
PRINT ~         ~
PRINT ~END Containers in areas~
PRINT ~         ~

END
*/

COPY ~weidu_external/PoFQuestPack/Areas/XG0000.ARE~         ~override/XG0000.ARE~

COPY ~weidu_external/PoFQuestPack/Areas/XG0001.ARE~         ~override/XG0001.ARE~

COPY ~weidu_external/PoFQuestPack/Areas/XG0002.ARE~         ~override/XG0002.ARE~

ACTION_IF (GAME_IS ~bg2ee eet~) BEGIN

COPY ~weidu_external/PoFQuestPack/Areas/XG0003.ARE~			~override/XG0003.ARE~
  SAY 0x26b0 @398
  SAY 0x2838 @1000
			LPF fj_are_structure
				INT_VAR 
				fj_cre_strref0  =  RESOLVE_STR_REF (@1001)
				STR_VAR 
				fj_cre_resref0 = ~SHADOW01~
				fj_structure_type = interrupts
				fj_name  = XGSHAd
			END

END       

ACTION_IF (GAME_IS ~tob bgt~) BEGIN

