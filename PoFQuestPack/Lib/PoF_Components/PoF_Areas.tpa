		fj_vertex_3		= 482 + (1055 << 16)
		STR_VAR
		fj_structure_type	= region
		fj_name				= InfoPoint4
		fj_reg_script = XGGT004
		END
	LPF fj_are_structure
		INT_VAR
		fj_type			= 0    // Proximity trigge
		fj_box_left		= 214
		fj_box_top		= 1140
		fj_box_right	= 454
		fj_box_bottom	= 1278
		fj_cursor_idx	= 0   // curseur ?
		fj_flags	= BIT1 | BIT6  //
		//fj_info_point_strref  = RESOLVE_STR_REF (~Auras-tu la faiblesse d’esprit de tenter la traversée ?~) // See XGGT004.baf
		fj_loc_x		= 325
		fj_loc_y		= 1219
		fj_trap_active = 1
		fj_trap_status  = 0
		fj_vertex_0		= 214 + (1220 << 16)
		fj_vertex_1		= 423 + (1278 << 16)
		fj_vertex_2		= 454 + (1185 << 16)
		fj_vertex_3		= 360 + (1140 << 16)
		STR_VAR
		fj_structure_type	= region
		fj_name				= InfoPoint3
