IF
	Global("XG_PoF_GetMarco","GLOBAL",3)
THEN
  RESPONSE #100
		SetGlobal("EnteredAreaXG0964","XG0964",1)
		StartCutSceneMode()
		HideGUI()
		CreateCreature("XGPRISO1",[438.501],10)
		ActionOverride("XGPRISON",DisplayStringHead(Myself,@1/*~Veuillez patientez quelques instants.~*/))
		ActionOverride("XGPRISO1",MoveToPointNoInterrupt([701.644]))
		Wait(6)
		ActionOverride("XGPRISON",DisplayStringHead(Myself,@2 /*~Sécurisez et amenez le prisonnier Marco devant moi.~*/))
		Wait(3)
		ActionOverride("XGPRISO1",DisplayStringHead(Myself,@3 /*~Tout de suite.~*/))
		Wait(2)
		ActionOverride("XGPRISO1",MoveToPointNoInterrupt([701.644]))
		Wait(3)
		ActionOverride("XGPRISO1",DisplayStringHead(Myself,@4 /*~Allez Marco tu déménage.~*/))
		Wait(2)
		ActionOverride("XGMARK1",DisplayStringHead(Myself,@5 /*~C'est pas trop tôt, cette auberge n'est vraiment pas à mon goût...~*/))
		ActionOverride("XGPRISO1",MoveToPointNoInterrupt([627.655]))
		Wait(4)
		ActionOverride("XGPRISO1",DisplayStringHead(Myself,@6 /*~Tu te crois où ?~*/))
		Wait(2)
		ActionOverride("XGPRISO1",MoveToPointNoInterrupt([726.605]))
		ActionOverride("XGMARK1",DisplayStringHead(Myself,@7 /*~... Le service laisse à désirer aussi...~*/))
		Wait(4)
		ActionOverride("XGPRISON",DisplayStringHead(Myself,@8 /*~Nous verrons si tes compatriotes d'Eauprofonde t'offrirons une meilleure cellule... En attendant ton exécution...~*/))
		Wait(5)
		ActionOverride("XGMARK1",DisplayStringHead(Myself,@9 /*~... Des brimades, de la violence... Vraiment je ne vous recommanderais pas à mes amis.~*/))
		Wait(4)
		ActionOverride(Player1,DisplayStringHead(Myself,@10 /*~Le sort du prisonnier n'a pas encore était décidé.~*/))
		Wait(3)
		ActionOverride("XGPRISO1",DisplayStringHead(Myself,@11 /*~Allons, allons malgré ce que l'humour de Marco pourrait laisser croire, nos prisonnier sont traités avec respect.~*/))
		Wait(6)
		ActionOverride("XGPRISON",DisplayStringHead(Myself,@12 /*~En effet, même les plus difficile... Les documents sont en règles notre rôle est terminé.~*/))
		Wait(3)
		ActionOverride(Player1,DisplayStringHead(Myself,@13 /*~Alors tout est paré, en avant !.~*/))
		Wait(3)
		FadeToColor([50.0],0)
		SetGlobal("XG_PoF_GetMarco","GLOBAL",4)
		AddJournalEntry(@51405,QUEST)
		ActionOverride("XGMARK1",LeaveAreaLUA("XG0364","",[549.365],14))
		ActionOverride(Player2,LeaveAreaLUA("XG0364","",[536.485],0))
		ActionOverride(Player1,LeaveAreaLUA("XG0364","",[589.449],0))
		ActionOverride(Player3,LeaveAreaLUA("XG0364","",[495.560],0))
		ActionOverride(Player4,LeaveAreaLUA("XG0364","",[743.523],0))
		ActionOverride(Player5,LeaveAreaLUA("XG0364","",[821.568],0))
		ActionOverride(Player6,LeaveAreaLUA("XG0364","",[490.565],0))
		UnhideGUI()
		EndCutSceneMode()
END
